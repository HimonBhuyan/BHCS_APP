APP_NAME="Blue Hour HQ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.bluehourstudios.in

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=blue_hour_hq
DB_USERNAME=bluehour
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=bluehour-hq
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="ws.bluehourstudios.in"
REVERB_PORT=443
REVERB_SCHEME=https

FIREBASE_CREDENTIALS=/etc/bluehour/firebase-service-account.json
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=bluehour-hq-vault

